<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xbot_aw_row_root" android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
        <TextView android:id="@+id/xbot_aw_row_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/xbot_alert_widget_text" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/xbot_aw_row_period" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:textSize="11sp" android:textColor="@color/xbot_alert_widget_muted" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
        <TextView android:id="@+id/xbot_aw_row_expiry" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/xbot_alert_widget_muted"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/xbot_aw_row_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/xbot_alert_widget_text" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
