<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xbot_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xbot_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="9dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/xbot_widget_signal_icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/xbot_widget_preview_signal_icon"
        android:scaleType="centerInside"
        android:src="@drawable/xbot_ic_signal_ma_trend" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/xbot_widget_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="110dp"
                android:text="@string/xbot_widget_preview_symbol"
                android:textColor="@color/xbot_widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/xbot_widget_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/xbot_widget_name"
                android:textColor="@color/xbot_widget_muted"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/xbot_widget_settings"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/xbot_widget_settings"
                android:padding="6dp"
                android:src="@drawable/xbot_ic_settings" />

            <ImageButton
                android:id="@+id/xbot_widget_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/xbot_widget_refresh"
                android:padding="6dp"
                android:src="@drawable/xbot_ic_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/xbot_widget_comment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/xbot_widget_comment_plain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xbot_widget_muted"
                android:textSize="10sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/xbot_widget_open_long"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/xbot_widget_preview_open_long"
                    android:textColor="@color/xbot_signal_green"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/xbot_widget_open_short"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/xbot_widget_preview_open_short"
                    android:textColor="@color/xbot_signal_red"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/xbot_widget_close_long"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/xbot_widget_preview_close_long"
                    android:textColor="@color/xbot_signal_cyan"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/xbot_widget_close_short"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/xbot_widget_preview_close_short"
                    android:textColor="@color/xbot_signal_orange"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/xbot_widget_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/xbot_widget_preview_level"
            android:textColor="@color/xbot_widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/xbot_widget_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/xbot_widget_preview_direction"
            android:textColor="@color/xbot_signal_green"
            android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/xbot_widget_expiry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/xbot_widget_preview_expiry"
            android:textColor="@color/xbot_widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/xbot_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/xbot_widget_preview_updated"
            android:textColor="@color/xbot_widget_muted"
            android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
